
# hide elements in list view
mod.web_list.table.tx_wsslider_domain_model_item.hideTable = 1


mod.wizards.newContentElement.wizardItems.common {
  elements {
    ws-slider {
      iconIdentifier = content-wsslider
      title = LLL:EXT:ws_slider/Resources/Private/Language/locallang.xlf:title
      description = LLL:EXT:ws_slider/Resources/Private/Language/locallang.xlf:description
      tt_content_defValues {
        CType = ws_slider
      }
    }
  }
  show := addToList(ws-slider)
}
