# customcategory=plugin.tx_wsslider.swiper=WS Slider - Swiper

plugin.tx_wsslider.settings.swiper {

  # cat=plugin.tx_wsslider.swiper/navigation/a; type=options[true,false]; label=
  autoplayProgress = false


  # cat=plugin.tx_wsslider.swiper/basic/001; type=string; label=Swiper Richtung: horizontal|vertical
  direction = horizontal



  # cat=plugin.tx_wsslider.swiper/basic/003; type=int; label=Slides pro View
  slidesPerView = 1

  # cat=plugin.tx_wsslider.swiper/basic/004; type=int; label=Slides pro Gruppe
  slidesPerGroup = 1

  # cat=plugin.tx_wsslider.swiper/basic/005; type=int; label=Abstand zwischen Slides (px)
  spaceBetween = 0

  # cat=plugin.tx_wsslider.swiper/basic/006; type=int; label=Animation Speed (ms)
  speed = 300

  # cat=plugin.tx_wsslider.swiper/navigation/010; type=boolean; label=Navigation aktivieren
  navigation = 0

  # cat=plugin.tx_wsslider.swiper/pagination/020; type=boolean; label=Pagination aktivieren
  pagination = 0

  # cat=plugin.tx_wsslider.swiper/autoplay/030; type=boolean; label=Autoplay aktivieren
  autoplay = 0

  # cat=plugin.tx_wsslider.swiper/autoplay/031; type=int; label=Autoplay Delay (ms)
  autoplayDelay = 5000

  # cat=plugin.tx_wsslider.swiper/effects/040; type=string; label=Effekt: slide|fade|cube|coverflow|flip|creative|cards
  effect = slide

  # cat=plugin.tx_wsslider.swiper/loop/050; type=boolean; label=Loop aktivieren
  loop = 0

  # cat=plugin.tx_wsslider.swiper/interaction/060; type=boolean; label=Touch Move erlauben
  allowTouchMove = 1

  # cat=plugin.tx_wsslider.swiper/interaction/061; type=int; label=Swipe Threshold
  threshold = 5


  a11y {
    # cat=plugin.tx_wsslider.swiper/a11y/a; type=options[true,false]; label=enabled
    enabled = true

    # cat=plugin.tx_wsslider.swiper/a11y/b; type=string; label=prevSlideMessage
    prevSlideMessage = LLL:EXT:ws_slider/Resources/Private/Language/swiper.xlf:settings.a11y.prevSlideMessage

    # cat=plugin.tx_wsslider.swiper/a11y/c; type=string; label=nextSlideMessage
    nextSlideMessage = LLL:EXT:ws_slider/Resources/Private/Language/swiper.xlf:settings.a11y.nextSlideMessage

    # cat=plugin.tx_wsslider.swiper/a11y/d; type=string; label=firstSlideMessage
    firstSlideMessage = This is the first slide

    # cat=plugin.tx_wsslider.swiper/a11y/e; type=string; label=lastSlideMessage
    lastSlideMessage = This is the last slide

    # cat=plugin.tx_wsslider.swiper/a11y/f; type=string; label=paginationBulletMessage
    paginationBulletMessage = Go to slide {{index}}
  }


  fadeEffect {
    # cat=plugin.tx_wsslider.swiper/effects/fade/a; type=options[true,false]; label=Crossfade
    crossFade = true
  }

  flipEffect {
    # cat=plugin.tx_wsslider.swiper/effects/flip/a; type=options[true,false]; label=Slide Shadows
    slideShadows = true

  }


  focusableElements = input, select, option, textarea, button, video, label

  freeMode {
    # cat=plugin.tx_wsslider.swiper/freeMode/a; type=options[true,false]; label=enabled
    enabled = true

    # cat=plugin.tx_wsslider.swiper/freeMode/b; type=options[true,false]; label=sticky
    sticky = true
  }

  grid {
    # cat=plugin.tx_wsslider.swiper/grid/a; type=int+; label=Rows
    rows = 1

  }

  hashNavigation {
    # cat=plugin.tx_wsslider.swiper/hashNavigation/b; type=options[true,false]; label=replaceState
    replaceState = true
  }

  history {
    # cat=plugin.tx_wsslider.swiper/history/a; type=options[true,false]; label=enabled
    enabled = false
  }

  # cat=plugin.tx_wsslider.swiper/basic/002; type=int; label=Anfangs-Slide (Index)
  initialSlide = 0

  keyboard {
    # cat=plugin.tx_wsslider.swiper/keyboard/a; type=options[true,false]; label=enabled
    enabled = true

    # cat=plugin.tx_wsslider.swiper/keyboard/b; type=options[true,false]; label=onlyInViewport
    onlyInViewport = true
  }

  breakpoints {
    # cat=plugin.tx_wsslider.swiper/navigation/b; type=int+; label=Breakpoint at 576px
    576 {
      # cat=plugin.tx_wsslider.swiper/navigation/b; type=int+; label=Number of items to display
      slidesPerView = 1
    }

    # cat=plugin.tx_wsslider.swiper/navigation/c; type=int+; label=Breakpoint at 768px
    768 {
      # cat=plugin.tx_wsslider.swiper/navigation/c; type=int+; label=Number of items to display
      slidesPerView = 2
    }

    # cat=plugin.tx_wsslider.swiper/navigation/d; type=int+; label=Breakpoint at 992px
    992 {
      # cat=plugin.tx_wsslider.swiper/navigation/d; type=int+; label=Number of items to display
      slidesPerView = 3
    }

    # cat=plugin.tx_wsslider.swiper/navigation/e; type=int+; label=Breakpoint at 1200px
    1200 {
      # cat=plugin.tx_wsslider.swiper/navigation/e; type=int+; label=Number of items to display
      slidesPerView = 4
    }

    # cat=plugin.tx_wsslider.swiper/navigation/f; type=int+; label=Breakpoint at 1400px
    1400 {
      # cat=plugin.tx_wsslider.swiper/navigation/f; type=int+; label=Number of items to display
      slidesPerView = 5
    }
  }

}
