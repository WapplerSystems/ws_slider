{
    "name": "wapplersystems/ws-slider",
    "type": "typo3-cms-extension",
    "description": "universal slider extension for tinyslider, swiper, flexslider, ...",
    "homepage": "https://github.com/WapplerSystems/ws_slider",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "typo3",
        "TYPO3 CMS",
        "Flexslider",
        "swiper",
        "slick",
        "tinyslider"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/ws_slider/issues",
        "source": "https://github.com/WapplerSystems/ws_slider"
    },
    "require": {
        "typo3/cms-core": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\WsSlider\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ws_slider"
        }
    }
}